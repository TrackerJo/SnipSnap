# SnipSnap API Configuration
# 
# This app uses AI to improve task descriptions and verify task completion.
# You need at least one API key configured.
#
# NOTE: API keys are stored in your browser's localStorage for demo purposes.
# For production apps, use a secure backend to handle API keys.

# Google Gemini API Key (Currently Active)
# Get your free API key from: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=AIzaSyDU4ryiEj8-l7Ijv2DkoWQq_Om_0MYq8jU

# Anthropic Claude API Key (For Future Use)
# Get your API key from: https://console.anthropic.com/
# VITE_CLAUDE_API_KEY=your_claude_api_key_here

# Note: These environment variables are optional.
# The app provides a UI to enter API keys directly in the Settings dialog.

# Firebase Configuration
# Get these values from your Firebase Console: https://console.firebase.google.com/
# Project Settings > General > Your apps > Web app

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
